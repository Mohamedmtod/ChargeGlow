    "ChargeGlow could not end the Live Activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على ChargeGlow إنهاء النشاط المباشر."
          }
        }
      }
    },
    "ChargeGlow could not start the Live Activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على ChargeGlow بدء النشاط المباشر."
          }
        }
      }
    },
    "ChargeGlow could not start. Open the app and export diagnostics." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر بدء ChargeGlow. افتح التطبيق وصدّر التشخيصات."
          }
        }
      }
    },
    "ChargeGlow could not update the Live Activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على ChargeGlow تحديث النشاط المباشر."
          }
        }
      }
    },
    "ChargeGlow is already running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChargeGlow قيد التشغيل بالفعل."
          }
        }
      }
    },
    "ChargeGlow refreshes once per minute while foregrounded. After suspension, the Live Activity marks its last public API reading as outdated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدّث ChargeGlow القراءة مرة كل دقيقة أثناء وجوده في الواجهة. بعد التعليق، يضع النشاط المباشر علامة «قديمة» على آخر قراءة من واجهة النظام العامة."
          }
        }
      }
    },
    "ChargeGlow started, but iOS did not provide a battery percentage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدأ ChargeGlow، لكن iOS لم يوفر نسبة البطارية."
          }
        }
      }
    },
    "ChargeGlow started with the current iOS battery reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدأ ChargeGlow باستخدام قراءة البطارية الحالية من iOS."
          }
        }
      }
    },
