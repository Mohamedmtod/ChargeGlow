{
  "sourceLanguage" : "en",
  "strings" : {
    "Accuracy depends on the external meter, cable, and measurement point. The calculated power is voltage multiplied by current." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعتمد الدقة على المقياس الخارجي والكابل ونقطة القياس. تُحسب القدرة بضرب الجهد في التيار."
          }
        }
      }
    },
    "Battery temperature" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درجة حرارة البطارية"
          }
        }
      }
    },
    "Calculated input power" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرة الإدخال المحسوبة"
          }
        }
      }
    },
    "ChargeGlow never estimates volts, milliamps, watts, temperature, or charger quality from battery percentage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يقدّر ChargeGlow الجهد أو المللي أمبير أو الواط أو الحرارة أو جودة الشاحن من نسبة البطارية."
          }
        }
      }
    },
    "Charging current" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تيار الشحن"
          }
        }
      }
    },
    "Clear meter values" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسح قيم المقياس"
          }
        }
      }
    },
    "Electrical charging details" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفاصيل الشحن الكهربائية"
          }
        }
      }
    },
    "Enter positive voltage and current values to calculate watts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل قيمًا موجبة للجهد والتيار لحساب الواط."
          }
        }
      }
    },
    "Enter the values shown by a USB power meter for a real electrical measurement." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل القيم التي يعرضها مقياس طاقة USB للحصول على قياس كهربائي حقيقي."
          }
        }
      }
    },
    "External USB power meter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقياس طاقة USB خارجي"
          }
        }
      }
    },
    "Input power" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرة الإدخال"
          }
        }
      }
    },
    "Input voltage" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهد الإدخال"
          }
        }
